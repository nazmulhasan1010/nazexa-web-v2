generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model HomeSection {
  id       String  @id @default(uuid())
  type     String
  position Int
  visible  Boolean @default(true)
  title    String?
  subtitle String?
  content  String  @db.LongText

  @@map("home_sections")
}

model BuilderDraft {
  id        String   @id @default(uuid())
  key       String   @unique
  data      String   @db.LongText
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt

  @@map("builder_drafts")
}

model SiteSettings {
  id                      String  @id @default(uuid())
  site_name               String
  tagline                 String?
  default_seo_title       String?
  default_seo_description String? @db.Text
  theme                   String  @db.LongText

  @@map("site_settings")
}

model Page {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  eyebrow     String?
  description String? @db.Text

  // Page Builder Data
  draftData     String? @db.LongText // JSON schema of the draft page
  publishedData String? @db.LongText // JSON schema of the published page
  version       Int     @default(1)

  seo_title       String?
  seo_description String? @db.Text
  og_image_url    String?
  published       Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  revisions PageRevision[]

  @@map("pages")
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  schema    String   @db.LongText
  createdBy String?
  createdAt DateTime @default(now())

  @@map("page_revisions")
}

model BuilderComponent {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String  @default("General")
  schema      String  @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("builder_components")
}

model ContentItem {
  id         String   @id @default(uuid())
  collection String
  slug       String
  position   Int
  published  Boolean  @default(false)
  title      String?
  subtitle   String?  @db.Text
  body       String?  @db.LongText
  icon       String?
  tone       String?
  category   String?
  image_url  String?
  link_url   String?
  link_label String?
  data       String?  @db.LongText
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([collection])
  @@index([collection, published])
  @@map("content_items")
}

model JobPosting {
  id               String    @id @default(uuid())
  title            String
  slug             String    @unique
  department       String?
  location         String?
  level            String?
  employment_type  String?
  remote           Boolean   @default(false)
  excerpt          String?   @db.Text
  body             String?   @db.LongText
  responsibilities String?   @db.LongText
  requirements     String?   @db.LongText
  salary_band      String?
  apply_url        String?
  featured         Boolean   @default(false)
  published        Boolean   @default(false)
  position         Int       @default(0)
  posted_at        DateTime  @default(now())
  closes_at        DateTime?
  seo_title        String?
  seo_description  String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  @@index([published])
  @@map("job_postings")
}

model Resource {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String?  @db.Text
  body            String?  @db.LongText
  type            String   @default("Report")
  format          String?
  file_url        String?
  external_url    String?
  image_url       String?
  gated           Boolean  @default(false)
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  position        Int      @default(0)
  seo_title       String?
  seo_description String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([published])
  @@index([type])
  @@map("resources")
}

model PressAsset {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  type        String   @default("Logo")
  description String?  @db.Text
  file_url    String?
  formats     String?
  image_url   String?
  position    Int      @default(0)
  published   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("press_assets")
}

model CompanyMilestone {
  id         String   @id @default(uuid())
  date       String
  title      String
  body       String?  @db.Text
  tag        String?
  position   Int      @default(0)
  published  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("company_milestones")
}

model LearningPath {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  level           String?
  module_count    Int      @default(0)
  duration_label  String?
  summary         String?  @db.Text
  image_url       String?
  modules         String?  @db.LongText
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  position        Int      @default(0)
  seo_title       String?
  seo_description String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("learning_paths")
}

model Certification {
  id           String   @id @default(uuid())
  name         String
  requirements String?  @db.Text
  validity     String?
  position     Int      @default(0)
  published    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("certifications")
}

model Release {
  id              String             @id @default(uuid())
  version         String?
  title           String
  slug            String             @unique
  body            String?            @db.LongText
  type            String             @default("Feature")
  channel         String             @default("stable")
  released_at     DateTime           @default(now())
  security_until  DateTime?
  status          String             @default("Current")
  migration_notes String?            @db.Text
  featured        Boolean            @default(false)
  published       Boolean            @default(false)
  position        Int                @default(0)
  seo_title       String?
  seo_description String?            @db.Text
  created_at      DateTime           @default(now())
  updated_at      DateTime           @default(now()) @updatedAt
  artifacts       DownloadArtifact[]

  @@index([published])
  @@index([released_at])
  @@map("releases")
}

model DownloadArtifact {
  id            String   @id @default(uuid())
  kind          String   @default("CLI")
  name          String
  platform      String?
  architecture  String?
  language      String?
  package_name  String?
  version       String?
  file_url      String?
  file_size     String?
  checksum      String?  @db.Text
  signature_url String?
  status        String   @default("Stable")
  release_id    String?
  release       Release? @relation(fields: [release_id], references: [id], onDelete: SetNull)
  position      Int      @default(0)
  published     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  @@index([published])
  @@index([kind])
  @@index([release_id])
  @@map("download_artifacts")
}

model RoadmapItem {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  body            String?  @db.Text
  phase           String   @default("now")
  tag             String?
  target_label    String?
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  position        Int      @default(0)
  seo_title       String?
  seo_description String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([published])
  @@index([phase])
  @@map("roadmap_items")
}

model DocArticle {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String?  @db.Text
  body            String?  @db.LongText
  area            String?
  difficulty      String?
  version         String?
  reading_minutes Int      @default(0)
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  position        Int      @default(0)
  seo_title       String?
  seo_description String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([published])
  @@index([area])
  @@map("doc_articles")
}

model ApiEndpoint {
  id               String   @id @default(uuid())
  method           String   @default("GET")
  path             String
  summary          String?  @db.Text
  api_group        String?
  description      String?  @db.LongText
  request_example  String?  @db.LongText
  response_example String?  @db.LongText
  version          String?
  position         Int      @default(0)
  published        Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("api_endpoints")
}

model ApiErrorCode {
  id         String   @id @default(uuid())
  status     Int      @default(400)
  code       String
  meaning    String?  @db.Text
  position   Int      @default(0)
  published  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("api_error_codes")
}

model StatusComponent {
  id              String   @id @default(uuid())
  name            String
  component_group String?
  current_status  String   @default("operational")
  uptime_90d      String?
  p50_latency_ms  String?
  position        Int      @default(0)
  published       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  @@index([published])
  @@map("status_components")
}

model Incident {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  severity    String    @default("minor")
  status      String    @default("resolved")
  started_at  DateTime  @default(now())
  resolved_at DateTime?
  body        String?   @db.LongText
  updates     String?   @db.LongText
  published   Boolean   @default(false)
  position    Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  @@index([published])
  @@index([started_at])
  @@map("incidents")
}

model FeatureRequest {
  id         String               @id @default(uuid())
  title      String
  slug       String               @unique
  body       String?              @db.Text
  status     String               @default("Under review")
  vote_count Int                  @default(0)
  category   String?
  featured   Boolean              @default(false)
  published  Boolean              @default(false)
  position   Int                  @default(0)
  created_at DateTime             @default(now())
  updated_at DateTime             @default(now()) @updatedAt
  votes      FeatureRequestVote[]

  @@index([published])
  @@map("feature_requests")
}

model FeatureRequestVote {
  id         String         @id @default(uuid())
  request_id String
  request    FeatureRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  voter_key  String
  created_at DateTime       @default(now())

  @@unique([request_id, voter_key])
  @@index([request_id])
  @@map("feature_request_votes")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  image                  String?                 @db.LongText
  password_hash          String?
  status                 String                  @default("active")
  lastLoginAt            DateTime?
  lastLoginIp            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  accounts               Account[]
  authorizations         Authorization[]
  emailVerificationCodes EmailVerificationCode[]
  payment_transactions   PaymentTransaction[]
  sessions               Session[]
  supportTickets         SupportTicket[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  email     String
  /// 6-digit numeric code (stored as bcrypt hash)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("email_verification_codes")
}

model Application {
  id                   String               @id @default(uuid())
  clientId             String               @unique
  clientSecret         String
  name                 String
  status               String               @default("active")
  redirectUris         String               @db.Text
  allowedOrigins       String?              @db.Text
  paymentWebhookUrl    String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  authorizations       Authorization[]
  payment_transactions PaymentTransaction[]
  supportTickets       SupportTicket[]

  @@map("applications")
}

model Authorization {
  id            String      @id @default(uuid())
  userId        String
  applicationId String
  scopes        String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@index([applicationId], map: "authorizations_applicationId_fkey")
  @@map("authorizations")
}

model UserEvent {
  id            String   @id @default(uuid())
  eventId       String   @unique @default(uuid())
  source        String
  centralUserId String
  eventType     String
  payload       String   @db.LongText
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@index([centralUserId])
  @@index([status])
  @@map("user_events")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String?
  email     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?

  @@map("contact_messages")
}

model ContactSettings {
  id       String @id @default(uuid())
  title    String
  subtitle String @db.Text
  phone    String
  email    String
  address  String

  @@map("contact_settings")
}

model AiProviderConfig {
  id             String   @id @default("global")
  activeProvider String
  googleApiKey   String?  @db.Text
  googleModel    String?
  updatedAt      DateTime @default(now()) @updatedAt

  @@map("aiproviderconfig")
}

model AiAgent {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String?
  model     String
  apiKey    String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("aiagent")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    String?  @db.MediumText
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@map("admin_roles")
}

model AdminSession {
  id          String    @id @default(uuid())
  userId      String
  expiresAt   DateTime
  admin_users AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "admin_sessions_userId_fkey")
  @@map("admin_sessions")
}

model AdminUser {
  id              String          @id @default(uuid())
  name            String?
  email           String          @unique
  password_hash   String
  role            String          @default("admin")
  status          String          @default("active")
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())
  admin_sessions  AdminSession[]
  assignedTickets SupportTicket[]

  @@map("admin_users")
}

model AiJob {
  id         String   @id @default(uuid())
  appId      String
  userId     String
  prompt     String   @db.LongText
  context    String?  @db.LongText
  status     String   @default("pending")
  response   String?  @db.LongText
  error      String?  @db.Text
  provider   String?
  modelUsed  String?
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([appId, userId])
  @@index([status])
  @@map("ai_jobs")
}

model AiUsageRecord {
  id              String   @id @default(uuid())
  jobId           String?  @unique // one record per job, guaranteed
  provider        String // "openai" | "groq" | "openrouter" | "google" | "custom"
  model           String
  appId           String?
  userId          String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  cachedTokens    Int      @default(0)
  reasoningTokens Int      @default(0)
  costUsd         Float?
  costSource      String? // "actual" | "estimated"
  latencyMs       Int?
  status          String // "success" | "error"
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
  @@index([status])
  @@index([userId, createdAt])
  @@map("ai_usage_records")
}

// ----------------------------------------------------------------------------
// CENTRAL SUPPORT & TICKET SYSTEM
// ----------------------------------------------------------------------------

model SupportTicket {
  id          String @id @default(uuid())
  number      Int    @unique @default(autoincrement())
  subject     String
  description String @db.LongText

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  categoryId String?
  category   SupportCategory? @relation(fields: [categoryId], references: [id])

  priority String @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status   String @default("OPEN") // OPEN | IN_PROGRESS | WAITING_FOR_USER | WAITING_FOR_SUPPORT | RESOLVED | CLOSED

  assignedToId String?
  assignedTo   AdminUser? @relation(fields: [assignedToId], references: [id])

  messages  SupportMessage[]
  tags      SupportTicketTag[]
  histories SupportTicketHistory[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  closedAt      DateTime?
  completedAt   DateTime?
  completedById String?
  skippedAt     DateTime?
  skippedById   String?
  lastReplyAt   DateTime  @default(now())

  resolution String? @db.LongText

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@map("support_tickets")
}

model SupportTicketHistory {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  previousStatus String?
  newStatus      String

  changedBy   String // "USER" or "ADMIN"
  changedById String

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("support_ticket_history")
}

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderType String // USER | ADMIN | SYSTEM | AI

  // Can be a central User ID or Admin ID depending on senderType
  senderId String?

  body         String  @db.LongText
  internalNote Boolean @default(false)

  attachments SupportAttachment[]

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

model SupportAttachment {
  id        String         @id @default(uuid())
  messageId String
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName   String
  fileSize   Int
  mimeType   String
  storageKey String

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("support_attachments")
}

model SupportCategory {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  active      Boolean         @default(true)
  tickets     SupportTicket[]
  createdAt   DateTime        @default(now())

  @@map("support_categories")
}

model SupportTag {
  id      String             @id @default(uuid())
  name    String             @unique
  color   String?
  tickets SupportTicketTag[]

  @@map("support_tags")
}

model SupportTicketTag {
  ticketId String
  tagId    String

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    SupportTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("support_ticket_tags")
}

model SupportEmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "TICKET_CREATED", "TICKET_RESOLVED"
  subject     String
  body        String   @db.LongText
  description String?
  active      Boolean  @default(true)
  variables   String?  @db.Text // Comma separated list of available variables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("support_email_templates")
}

/// Per-user daily rollup of AI usage. Powers the contribution heatmap,
/// active-users counts and fast per-user analytics. Incremented once per
/// newly-created AiUsageRecord (see recordAiUsage in src/lib/ai/usage.ts).
model AiUserDailyUsage {
  id           String   @id @default(uuid())
  userId       String
  date         String // 'YYYY-MM-DD' UTC — matches ActivityHeatmap key format
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Float    @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@map("ai_user_daily_usage")
}

/// Latest account snapshot per provider, refreshed server-side from the
/// provider APIs (OpenRouter live; OpenAI/Groq rate-limit headers captured
/// from real traffic; Google unavailable). Lets the dashboard load cached
/// stats instantly and show an accurate lastSyncedAt.
model AiProviderStat {
  id           String    @id @default(uuid())
  provider     String    @unique // "openai" | "groq" | "openrouter" | "google" | "custom"
  status       String    @default("unavailable") // "ok" | "error" | "unavailable"
  balance      Float?
  usage        Float?
  quota        Float?
  remaining    Float?
  requests     Int?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  rateLimits   String?   @db.Text // JSON: {requests:{limit,remaining,reset},tokens:{...},retryAfter}
  extra        String?   @db.Text // JSON: {usageDaily,usageWeekly,usageMonthly,isFreeTier,note}
  raw          String?   @db.Text // full provider response, for debugging
  error        String?   @db.Text
  syncedAt     DateTime? // last successful account sync (OpenRouter live fetch)
  headersAt    DateTime? // last rate-limit header capture (OpenAI/Groq)
  updatedAt    DateTime  @default(now()) @updatedAt
  createdAt    DateTime  @default(now())

  @@map("ai_provider_stats")
}

model ManualPaymentProof {
  id                   String             @id @default(uuid())
  transactionId        String
  fields               Json
  note                 String?            @db.Text
  submittedAt          DateTime           @default(now())
  payment_transactions PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("manual_payment_proofs")
}

model PaymentAttempt {
  id                   String             @id @default(uuid())
  transactionId        String
  gatewayCode          String
  status               String
  gatewayTransactionId String?
  gatewayOrderId       String?
  gatewayPaymentId     String?
  requestSummary       String?            @db.Text
  responseSummary      String?            @db.Text
  errorMessage         String?            @db.Text
  createdAt            DateTime           @default(now())
  payment_transactions PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("payment_attempts")
}

model PaymentGateway {
  id                   String               @id @default(uuid())
  code                 String               @unique
  displayName          String?
  type                 String               @default("manual")
  instructions         String?              @db.Text
  config               Json?
  isEnabled            Boolean              @default(false)
  environment          String               @default("sandbox")
  priority             Int                  @default(100)
  sortOrder            Int                  @default(0)
  supportedCurrencies  String?              @db.Text
  allowedApplications  String?              @db.Text
  allowedProducts      String?              @db.Text
  supportsRecurring    Boolean              @default(false)
  supportsRefund       Boolean              @default(false)
  supportsWebhook      Boolean              @default(false)
  supportsManualReview Boolean              @default(true)
  lastTestAt           DateTime?
  lastTestStatus       String?
  lastTestMessage      String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now())
  payment_transactions PaymentTransaction[]

  @@index([isEnabled, priority])
  @@map("payment_gateways")
}

model PaymentProductPlan {
  id          String   @id @default(uuid())
  productCode String
  planCode    String
  planName    String
  currency    String
  amount      Decimal  @db.Decimal(12, 2)
  interval    String?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([productCode, planCode, currency])
  @@index([productCode, isActive])
  @@map("payment_product_plans")
}

model PaymentRefund {
  id                   String             @id @default(uuid())
  transactionId        String
  amount               Decimal            @db.Decimal(12, 2)
  currency             String
  status               String             @default("REFUND_REQUESTED")
  gatewayRefundId      String?
  reason               String?            @db.Text
  isManual             Boolean            @default(false)
  requestedBy          String?
  failureReason        String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now())
  completedAt          DateTime?
  payment_transactions PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionId])
  @@map("payment_refunds")
}

model PaymentTransaction {
  id                     String                @id @default(uuid())
  publicId               String                @unique
  userId                 String
  appId                  String?
  product                String
  productId              String?
  plan                   String
  planId                 String?
  amount                 Decimal               @db.Decimal(12, 2)
  currency               String                @default("USD")
  amountUsd              Decimal               @default(0.00) @db.Decimal(12, 2)
  gatewayId              String?
  gatewayTransactionId   String?
  gatewayOrderId         String?
  gatewayPaymentId       String?
  status                 String                @default("CREATED")
  failureReason          String?               @db.Text
  source                 String?
  metadata               String?               @db.Text
  reference              String?
  details                Json?
  adminNote              String?               @db.Text
  reviewedBy             String?
  reviewedAt             DateTime?
  idempotencyKey         String?               @unique
  returnUrl              String?               @db.Text
  cancelUrl              String?               @db.Text
  fulfillmentStatus      String                @default("PENDING")
  fulfilledAt            DateTime?
  expiresAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now())
  paidAt                 DateTime?
  manual_payment_proofs  ManualPaymentProof[]
  payment_attempts       PaymentAttempt[]
  payment_refunds        PaymentRefund[]
  applications           Application?          @relation(fields: [appId], references: [id])
  payment_gateways       PaymentGateway?       @relation(fields: [gatewayId], references: [id])
  users                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment_webhook_events PaymentWebhookEvent[]

  @@index([appId])
  @@index([gatewayId], map: "payment_transactions_gatewayId_fkey")
  @@index([gatewayOrderId])
  @@index([gatewayTransactionId])
  @@index([status])
  @@index([userId])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id                   String              @id @default(uuid())
  gateway              String
  eventId              String?
  transactionId        String?
  eventType            String?
  processingStatus     String              @default("RECEIVED")
  failureReason        String?             @db.Text
  payload              String?             @db.MediumText
  receivedAt           DateTime            @default(now())
  processedAt          DateTime?
  payment_transactions PaymentTransaction? @relation(fields: [transactionId], references: [id])

  @@unique([gateway, eventId])
  @@index([processingStatus])
  @@index([transactionId])
  @@map("payment_webhook_events")
}

model Subscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  status         String    @default("ACTIVE") // "ACTIVE" | "UNSUBSCRIBED"
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  deliveries NewsletterDelivery[]

  @@index([status])
  @@map("subscribers")
}

model NewsletterCampaign {
  id              String    @id @default(uuid())
  type            String // "NEWS" | "CUSTOM"
  subject         String
  contentHtml     String?   @db.LongText
  status          String    @default("DRAFT") // "DRAFT" | "QUEUED" | "PROCESSING" | "COMPLETED" | "PARTIALLY_FAILED" | "FAILED"
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  newsId          String? // Reference to the published news ID to prevent duplicate campaigns
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  deliveries NewsletterDelivery[]

  @@index([newsId])
  @@index([status])
  @@map("newsletter_campaigns")
}

model NewsletterDelivery {
  id           String    @id @default(uuid())
  campaignId   String
  subscriberId String
  status       String    @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  error        String?   @db.Text
  sentAt       DateTime?

  campaign   NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@map("newsletter_deliveries")
}

model SecuritySettings {
  id                 String   @id @default("global")
  turnstileEnabled   Boolean  @default(false)
  turnstileSiteKey   String?  @db.Text
  turnstileSecretKey String?  @db.Text
  updatedAt          DateTime @default(now()) @updatedAt

  @@map("security_settings")
}

// ----------------------------------------------------------------------------
// WEBMAIL / MAILBOX SYSTEM
// ----------------------------------------------------------------------------

model MailAccount {
  id          String @id @default(uuid())
  displayName String
  email       String
  provider    String @default("custom") // gmail | outlook | yahoo | custom

  // IMAP config
  imapHost        String
  imapPort        Int    @default(993)
  imapSecurity    String @default("SSL/TLS") // SSL/TLS | STARTTLS | NONE
  imapUsername    String
  imapPasswordEnc String @db.Text // AES-256-GCM encrypted

  // SMTP config
  smtpHost        String
  smtpPort        Int    @default(587)
  smtpSecurity    String @default("STARTTLS") // SSL/TLS | STARTTLS | NONE
  smtpUsername    String
  smtpPasswordEnc String @db.Text // AES-256-GCM encrypted

  // Signature
  signature String? @db.LongText

  // Status
  status        String    @default("active") // active | error | disconnected
  lastSyncAt    DateTime?
  lastSyncError String?   @db.Text
  lastSyncCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  folders  MailFolder[]
  messages MailMessage[]
  drafts   MailDraft[]

  @@index([email])
  @@map("mail_accounts")
}

model MailFolder {
  id        String      @id @default(uuid())
  accountId String
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name        String // IMAP folder name e.g. "INBOX", "Sent"
  displayName String // Human-readable label
  type        String @default("custom") // inbox | sent | drafts | trash | spam | archive | custom
  uidValidity Int?
  unreadCount Int    @default(0)
  totalCount  Int    @default(0)

  messages MailMessage[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("mail_folders")
}

model MailMessage {
  id        String      @id @default(uuid())
  accountId String
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    MailFolder? @relation(fields: [folderId], references: [id])

  // IMAP identifiers (prevent duplicate sync)
  uid       Int
  messageId String? // RFC822 Message-ID header
  threadId  String? // Derived from References/In-Reply-To

  // Headers
  fromName     String?
  fromEmail    String
  toAddresses  String   @db.Text // JSON array of { name, email }
  ccAddresses  String?  @db.Text
  bccAddresses String?  @db.Text
  subject      String
  date         DateTime

  // Body
  bodyHtml String? @db.LongText
  bodyText String? @db.LongText
  preview  String? @db.Text // First 200 chars of plain text

  // Flags
  isRead        Boolean @default(false)
  isStarred     Boolean @default(false)
  isImportant   Boolean @default(false)
  hasAttachment Boolean @default(false)

  // Status: inbox | sent | draft | trash | spam | archive
  folderType String @default("inbox")

  attachments MailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([accountId, folderId, uid])
  @@index([accountId])
  @@index([folderId])
  @@index([date])
  @@index([isRead])
  @@index([messageId])
  @@map("mail_messages")
}

model MailAttachment {
  id        String      @id @default(uuid())
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String // filename under .data/mail-attachments/
  cid        String? // Content-ID for inline images

  @@index([messageId])
  @@map("mail_attachments")
}

model MailDraft {
  id        String      @id @default(uuid())
  accountId String
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  toAddresses       String? @db.Text // JSON
  ccAddresses       String? @db.Text
  bccAddresses      String? @db.Text
  subject           String?
  bodyHtml          String? @db.LongText
  bodyText          String? @db.LongText
  attachments       String? @db.Text // JSON array of storageKeys
  templateId        String?
  templateVersionId String?
  variableValues    String? @db.LongText // JSON
  designSnapshot    String? @db.LongText // JSON
  replyToId         String? // MailMessage id being replied to
  forwardOfId       String? // MailMessage id being forwarded

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([accountId])
  @@map("mail_drafts")
}

model MailTemplate {
  id         String                @id @default(uuid())
  name       String
  subject    String
  bodyHtml   String                @db.LongText
  bodyText   String?               @db.LongText
  variables  String?               @db.Text // comma-separated available vars
  categoryId String?
  category   MailTemplateCategory? @relation(fields: [categoryId], references: [id])
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt

  @@index([categoryId])
  @@map("mail_templates")
}

model MailTemplateCategory {
  id        String         @id @default(uuid())
  name      String         @unique
  templates MailTemplate[]
  createdAt DateTime       @default(now())

  @@map("mail_template_categories")
}

model MailAuditLog {
  id        String   @id @default(uuid())
  actorId   String // AdminUser id
  action    String // account_connected | email_sent | email_deleted | template_created ...
  accountId String?
  messageId String?
  details   String?  @db.Text // human-readable (NO credentials)
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([accountId])
  @@index([createdAt])
  @@map("mail_audit_logs")
}

model SystemEmailTemplate {
  id          String  @id @default(uuid())
  name        String
  key         String  @unique // e.g. "auth.verification"
  category    String  @default("System")
  subject     String
  contentHtml String  @db.LongText // Compiled email-safe HTML
  designJson  String  @db.LongText // Builder structural state
  status      String  @default("draft") // draft | published | archived
  description String?
  version     Int     @default(1)

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  versions SystemEmailTemplateVersion[]

  @@index([key])
  @@index([status])
  @@map("system_email_templates")
}

model SystemEmailTemplateVersion {
  id          String   @id @default(uuid())
  templateId  String
  version     Int
  subject     String
  contentHtml String   @db.LongText
  designJson  String   @db.LongText
  createdBy   String
  createdAt   DateTime @default(now())

  template SystemEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("system_email_template_versions")
}

model SystemConfig {
  id             String   @id @default(uuid())
  key            String   @unique
  category       String
  valuePlain     String?  @db.LongText
  valueEncrypted String?  @db.LongText
  valueType      String   @default("string") // string, number, boolean, json, secret, url, email
  isSecret       Boolean  @default(false)
  isPublic       Boolean  @default(false)
  isRequired     Boolean  @default(false)
  isEnabled      Boolean  @default(true)
  description    String?  @db.Text
  metadata       String?  @db.LongText
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  updatedBy      String?

  @@index([category])
  @@map("system_configs")
}

model SystemConfigLog {
  id        String   @id @default(uuid())
  configKey String
  action    String // created, updated, deleted, tested
  actorId   String?
  actorName String?
  details   String?  @db.LongText // JSON diff (never include raw secrets)
  createdAt DateTime @default(now())

  @@index([configKey])
  @@index([createdAt])
  @@map("system_config_logs")
}

model NavigationMenu {
  id        String           @id @default(uuid())
  type      String // "header" | "footer"
  status    String           @default("draft") // "draft" | "published"
  version   Int              @default(1)
  items     NavigationItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("navigation_menus")
}

model NavigationItem {
  id     String         @id @default(uuid())
  menuId String
  menu   NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parentId String?
  parent   NavigationItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children NavigationItem[] @relation("MenuHierarchy")

  label       String
  url         String?
  source      String? // e.g., "custom", "page", "content_library", "service"
  sourceId    String? // Stable ID of the referenced CMS entity
  target      String  @default("_self")
  icon        String?
  description String?

  order     Int     @default(0)
  isVisible Boolean @default(true)
  metadata  String? @db.Text // JSON for additional config (e.g. megaMenu toggles)

  @@map("navigation_items")
}
